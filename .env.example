# ==============================================================================
# Sentra OS — Canonical Environment Configuration Blueprint (.env.example)
# All values shown are safe synthetic placeholders for development and setup.
# NEVER place real production secrets or API keys into this file.
# ==============================================================================

# Core Runtime Environment
APP_ENV=development
PORT=8000
HTTP_PORT=80
SENTRA_APP_NAME="Sentra Tactical OS"
SENTRA_APP_VERSION="0.1.0"
SENTRA_API_PREFIX=""
SENTRA_HOST="0.0.0.0"

# Cryptographic Secrets (MUST be random >= 32 chars in production)
SECRET_KEY=replace_with_a_long_random_secret_at_least_32_characters_long
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_chars_long
INTERNAL_API_KEY=replace_with_a_long_random_internal_pipeline_api_key
SENTRA_PERSIST_SECRET=true

# Database Persistence (SQLite WAL default; PostgreSQL optional for Tier C)
DATABASE_URL=
DB_NAME=sentra
DB_USER=sentra_user
DB_PASSWORD=change_me_db_password
RENDER_DISK_PATH=

# Distributed Cache & Queues (Optional; Redis disabled in default single-node)
REDIS_URL=

# Browser & CORS Routing
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="Sentra"
NEXT_PUBLIC_API_BASE="/api"
NEXT_PUBLIC_API_BASE_URL="/api"
NEXT_PUBLIC_WS_BASE_URL="/ws/incidents"
ALLOWED_ORIGINS="http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000,https://sentra-01.vercel.app"

# Initial Administrative Operator (Seeded only when APP_ENV=development)
ADMIN_EMAIL=admin@sentra.local
ADMIN_PASSWORD=change_me_admin_password
SENTRA_ENABLE_DEMO_SEED=false

# Authentication Cookie Security
SENTRA_COOKIE_SECURE=false
SENTRA_ACCESS_COOKIE_NAME=sentra_access_token
SENTRA_REFRESH_COOKIE_NAME=sentra_refresh_token
SENTRA_ACCESS_TOKEN_MINUTES=15
SENTRA_REFRESH_TOKEN_DAYS=7

# Frontend Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_REALTIME_MAP=false
NEXT_PUBLIC_ENABLE_COMMAND_SURFACE_EXPERIMENTAL=false
NEXT_PUBLIC_REFRESH_MS=30000
NEXT_PUBLIC_HEAVY_REFRESH_MS=60000
NEXT_PUBLIC_ENABLE_LIVE_POLLING=true

# Multimodal Intelligence (Google GenAI Gemini SDK)
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"

# External Notification & Coordination Webhooks (Optional)
SENTRA_CAD_GATEWAY_URL=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SENTRA_ALERT_EMAIL_TO=

# External Intelligence Providers (Defaults to safe local simulation)
WEATHER_PROVIDER=demo
OPENWEATHER_API_KEY=
DEFAULT_LAT=11.0168
DEFAULT_LNG=76.9558
TRAFFIC_PROVIDER=demo
TRANSIT_PROVIDER=demo
UTILITY_PROVIDER=demo
CITY_MODE=campus
OSINT_PROVIDER=demo
NEWS_API_KEY=
GNEWS_API_KEY=
RSS_FEEDS=
SOCIAL_PROVIDER=demo
CITY_KEYWORDS=coimbatore,campus,zone,incident

# Billing Integrations (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Hardware Transport (Fail-closed unless physical hardware attached)
SENTRA_MQTT_ENABLED=false
SENTRA_MQTT_BROKER=mosquitto
SENTRA_MQTT_PORT=1883
SENTRA_IOT_STORE_PATH=./data/iot_store.json
SENTRA_IOT_NODE_TOKEN=
SENTRA_IOT_CAMERA_SNAPSHOT_URL=
SENTRA_IOT_CAMERA_STREAM_URL=

# Runtime Stability & Caching
INCIDENT_CACHE_TTL=60
PREDICTION_CACHE_TTL=45
ENABLE_FIRESTORE_FALLBACK_CACHE=true
SENTRA_LOG_LEVEL=INFO
SENTRA_LOG_FILE_PATH=logs/sentra-backend.jsonl
