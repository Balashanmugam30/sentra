# Sentra local production parity environment
APP_ENV=production
HTTP_PORT=80

# Secrets: replace before shared or production use.
SECRET_KEY=replace_with_a_long_random_secret
JWT_SECRET=replace_with_a_long_random_jwt_secret
INTERNAL_API_KEY=replace_with_a_long_random_internal_pipeline_key

# PostgreSQL
DB_NAME=sentra
DB_USER=sentra
DB_PASSWORD=change_me
DATABASE_URL=postgresql://sentra:change_me@postgres:5432/sentra

# Redis
REDIS_URL=redis://redis:6379/0

# Browser/API routing
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=Sentra
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_BASE_URL=/ws/incidents
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000

# Initial/demo operator values for local setup scripts.
ADMIN_EMAIL=admin@sentra.local
ADMIN_PASSWORD=change_me_admin_password

# Frontend feature flags
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_REALTIME_MAP=false
NEXT_PUBLIC_ENABLE_COMMAND_SURFACE_EXPERIMENTAL=false
NEXT_PUBLIC_REFRESH_MS=30000
NEXT_PUBLIC_HEAVY_REFRESH_MS=60000
NEXT_PUBLIC_ENABLE_LIVE_POLLING=true

# Firebase placeholders keep production builds deterministic when Firebase is not configured.
NEXT_PUBLIC_FIREBASE_API_KEY=demo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo.local
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sentra-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sentra-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=demo

# Optional external intelligence providers
WEATHER_PROVIDER=demo
OPENWEATHER_API_KEY=
DEFAULT_LAT=11.0168
DEFAULT_LNG=76.9558
TRAFFIC_PROVIDER=demo
TRANSIT_PROVIDER=demo
UTILITY_PROVIDER=demo
CITY_MODE=campus
OSINT_PROVIDER=demo
NEWS_API_KEY=
GNEWS_API_KEY=
RSS_FEEDS=
SOCIAL_PROVIDER=demo
CITY_KEYWORDS=coimbatore,campus,zone,incident

# Optional Stripe billing mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Optional hardware MQTT mode
SENTRA_MQTT_ENABLED=false
SENTRA_MQTT_BROKER=mosquitto
SENTRA_MQTT_PORT=1883

# Optional ESP32 smart edge prototype mode
SENTRA_IOT_STORE_PATH=./data/iot_store.json
SENTRA_IOT_NODE_TOKEN=
SENTRA_IOT_CAMERA_SNAPSHOT_URL=
SENTRA_IOT_CAMERA_STREAM_URL=

# Runtime stability
INCIDENT_CACHE_TTL=60
PREDICTION_CACHE_TTL=45
ENABLE_FIRESTORE_FALLBACK_CACHE=true
