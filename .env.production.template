APP_ENV=production
SENTRA_APP_VERSION=1.0.0
SENTRA_RELEASE_CHANNEL=production
SENTRA_RELEASE_COMMIT_SHA=replace_with_git_sha
HTTP_PORT=80

SECRET_KEY=replace_with_64_plus_char_random_secret
JWT_SECRET=replace_with_64_plus_char_random_jwt_secret
INTERNAL_API_KEY=replace_with_server_only_64_plus_char_internal_pipeline_key
SENTRA_COOKIE_SECURE=true
ALLOWED_ORIGINS=https://sentra.example.com

DB_NAME=sentra
DB_USER=sentra
DB_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://sentra:replace_with_strong_database_password@postgres:5432/sentra

REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=512mb

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=Sentra
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_BASE_URL=/ws/incidents
NEXT_PUBLIC_REFRESH_MS=30000
NEXT_PUBLIC_HEAVY_REFRESH_MS=60000
NEXT_PUBLIC_ENABLE_LIVE_POLLING=true

SENTRA_LOG_LEVEL=INFO
SENTRA_BACKUP_RETENTION_DAYS=30
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SENTRA_ALERT_EMAIL_TO=sre@example.com

WEATHER_PROVIDER=demo
OPENWEATHER_API_KEY=
OSINT_PROVIDER=demo
NEWS_API_KEY=
GNEWS_API_KEY=
TRAFFIC_PROVIDER=demo
TRANSIT_PROVIDER=demo
UTILITY_PROVIDER=demo

INCIDENT_CACHE_TTL=60
PREDICTION_CACHE_TTL=45
ENABLE_FIRESTORE_FALLBACK_CACHE=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
