APP_ENV=staging
SENTRA_APP_VERSION=1.0.0-rc.1
SENTRA_RELEASE_CHANNEL=staging
SENTRA_RELEASE_COMMIT_SHA=replace_with_git_sha
HTTP_PORT=8080

SECRET_KEY=replace_with_staging_secret
JWT_SECRET=replace_with_staging_jwt_secret
INTERNAL_API_KEY=replace_with_server_only_staging_internal_pipeline_key
SENTRA_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://staging.sentra.local

DB_NAME=sentra_staging
DB_USER=sentra
DB_PASSWORD=change_me_staging
DATABASE_URL=postgresql://sentra:change_me_staging@postgres:5432/sentra_staging

REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb

NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_NAME=Sentra Staging
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_BASE_URL=/ws/incidents
NEXT_PUBLIC_REFRESH_MS=30000
NEXT_PUBLIC_HEAVY_REFRESH_MS=60000
NEXT_PUBLIC_ENABLE_LIVE_POLLING=true

SENTRA_LOG_LEVEL=INFO
SENTRA_BACKUP_RETENTION_DAYS=14
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SENTRA_ALERT_EMAIL_TO=

WEATHER_PROVIDER=demo
OSINT_PROVIDER=demo
TRAFFIC_PROVIDER=demo
TRANSIT_PROVIDER=demo
UTILITY_PROVIDER=demo

INCIDENT_CACHE_TTL=60
PREDICTION_CACHE_TTL=45
ENABLE_FIRESTORE_FALLBACK_CACHE=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
