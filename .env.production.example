# Sentra production template
APP_ENV=production
HTTP_PORT=80

SECRET_KEY=CHANGE_ME_USE_64_RANDOM_CHARS_MINIMUM
JWT_SECRET=CHANGE_ME_USE_A_DIFFERENT_64_RANDOM_CHARS_MINIMUM
INTERNAL_API_KEY=CHANGE_ME_USE_A_SERVER_ONLY_64_RANDOM_CHARS_MINIMUM

DB_NAME=sentra
DB_USER=sentra
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://sentra:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/sentra
REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=Sentra
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_BASE_URL=/ws/incidents
ALLOWED_ORIGINS=https://sentra.example.com,http://localhost
SENTRA_COOKIE_SECURE=true

ADMIN_EMAIL=admin@sentra.local
ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD

NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_REALTIME_MAP=false
NEXT_PUBLIC_ENABLE_COMMAND_SURFACE_EXPERIMENTAL=false
NEXT_PUBLIC_REFRESH_MS=30000
NEXT_PUBLIC_HEAVY_REFRESH_MS=60000
NEXT_PUBLIC_ENABLE_LIVE_POLLING=true

NEXT_PUBLIC_FIREBASE_API_KEY=demo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo.local
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sentra-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sentra-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=demo

WEATHER_PROVIDER=demo
OPENWEATHER_API_KEY=
TRAFFIC_PROVIDER=demo
TRANSIT_PROVIDER=demo
UTILITY_PROVIDER=demo
OSINT_PROVIDER=demo
NEWS_API_KEY=
GNEWS_API_KEY=
RSS_FEEDS=
SOCIAL_PROVIDER=demo

INCIDENT_CACHE_TTL=60
PREDICTION_CACHE_TTL=45
ENABLE_FIRESTORE_FALLBACK_CACHE=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
